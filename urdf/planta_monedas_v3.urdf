    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="15.0" velocity="2.0"/>
  </joint>
  <link name="brazo2_seg2">
    <visual><geometry><cylinder radius="0.05" length="0.45"/></geometry><origin xyz="0 0 0.225" rpy="0 0 0"/><material name="brazo_b"/></visual>
    <inertial><mass value="1.5"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/></inertial>
  </link>
  <joint name="j_brazo2_codo" type="revolute">
    <parent link="brazo2_seg1"/><child link="brazo2_seg2"/>
    <origin xyz="0 0 0.50" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10.0" velocity="2.0"/>
  </joint>
  <link name="brazo2_gripper">
    <visual><geometry><box size="0.1 0.14 0.04"/></geometry><origin xyz="0 0 0.02" rpy="0 0 0"/><material name="pinza"/></visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="j_brazo2_muneca" type="revolute">
    <parent link="brazo2_seg2"/><child link="brazo2_gripper"/>
    <origin xyz="0 0 0.45" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" effort="5.0" velocity="2.0"/>
  </joint>
  <link name="brazo2_dedo_izq">
    <visual><geometry><box size="0.025 0.09 0.12"/></geometry><origin xyz="-0.055 0 0.06" rpy="0 0 0"/><material name="dedo"/></visual>
    <collision><geometry><box size="0.025 0.09 0.12"/></geometry><origin xyz="-0.055 0 0.06" rpy="0 0 0"/></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="j_brazo2_dedo_izq" type="prismatic">
    <parent link="brazo2_gripper"/><child link="brazo2_dedo_izq"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="0.03" effort="8.0" velocity="0.5"/>
  </joint>
  <link name="brazo2_dedo_der">
    <visual><geometry><box size="0.025 0.09 0.12"/></geometry><origin xyz="0.055 0 0.06" rpy="0 0 0"/><material name="dedo"/></visual>
    <collision><geometry><box size="0.025 0.09 0.12"/></geometry><origin xyz="0.055 0 0.06" rpy="0 0 0"/></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="j_brazo2_dedo_der" type="prismatic">
    <parent link="brazo2_gripper"/><child link="brazo2_dedo_der"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.03" effort="8.0" velocity="0.5"/>
  </joint>

  <link name="contenedor_200">
    <visual><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/><material name="azul_metal"/></visual>
    <visual><geometry><cylinder radius="0.14" length="0.04"/></geometry><origin xyz="0 0 0.40" rpy="0 0 0"/><material name="blanco_maquina"/></visual>
    <collision><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.2" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.2"/></inertial>
  </link>
  <joint name="j_contenedor_200" type="fixed">
    <parent link="base_planta"/><child link="contenedor_200"/>
    <origin xyz="1.0 -1.35 0.0" rpy="0 0 0"/>
  </joint>
  <link name="contenedor_500">
    <visual><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/><material name="azul_metal"/></visual>
    <visual><geometry><cylinder radius="0.14" length="0.04"/></geometry><origin xyz="0 0 0.40" rpy="0 0 0"/><material name="blanco_maquina"/></visual>
    <collision><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.2" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.2"/></inertial>
  </link>
  <joint name="j_contenedor_500" type="fixed">
    <parent link="base_planta"/><child link="contenedor_500"/>
    <origin xyz="1.5 -1.35 0.0" rpy="0 0 0"/>
  </joint>
  <link name="contenedor_1000">
    <visual><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/><material name="azul_metal"/></visual>
    <visual><geometry><cylinder radius="0.14" length="0.04"/></geometry><origin xyz="0 0 0.40" rpy="0 0 0"/><material name="blanco_maquina"/></visual>
    <collision><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.2" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.2"/></inertial>
  </link>
  <joint name="j_contenedor_1000" type="fixed">
    <parent link="base_planta"/><child link="contenedor_1000"/>
    <!-- Reposicionado lejos de brazo2_base (radio 0.25 m, centro en
         2.50,-4.80): a (3.00,-4.55) la distancia centro-centro es
         ~0.56 m, sin superposicion. Cerca de cinta_3 (Y=-4) para que
         siga siendo la "parada" logica de brazo2. -->
    <origin xyz="3.0 -4.55 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ========== PLACAS DE ESQUINA (soporte fisico en los giros) ==========
       Las cajas de colision de cinta_1/cinta_2 y cinta_2/cinta_3 solo se
       solapan ~10x10cm de forma natural (bandas de 30cm de ancho girando
       90 grados). Eso es insuficiente margen para una moneda que cambia
       de direccion de empuje justo ahi: se cae por el borde antes de
       llegar al area realmente solapada. Estas placas garantizan soporte
       fisico continuo en toda la zona de giro, sin depender de que las
       dos bandas coincidan al milimetro. -->
  <link name="placa_esquina_1">
    <visual><geometry><box size="0.5 0.5 0.05"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="acero"/></visual>
    <collision><geometry><box size="0.5 0.5 0.05"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
    <inertial><mass value="5.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
  </link>
  <joint name="j_placa_esquina_1" type="fixed">
    <parent link="base_planta"/><child link="placa_esquina_1"/>
    <!-- esquina cinta_1 -> cinta_2, world (-1.0, 0.0), superficie z=0.605 -->
    <origin xyz="-1.0 0.0 0.58" rpy="0 0 0"/>
  </joint>

  <link name="placa_esquina_2">
    <visual><geometry><box size="0.5 0.5 0.05"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="acero"/></visual>
    <collision><geometry><box size="0.5 0.5 0.05"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
    <inertial><mass value="5.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
  </link>
  <joint name="j_placa_esquina_2" type="fixed">
    <parent link="base_planta"/><child link="placa_esquina_2"/>
    <!-- esquina cinta_2 -> cinta_3, world (-1.0, -4.0), superficie z=0.605 -->
    <origin xyz="-1.0 -4.0 0.58" rpy="0 0 0"/>
  </joint>

  <!-- placa_muelle: la banda cinta_3 solo tiene colision fisica hasta
       X=2.95 (su caja real, 3.9m centrada en su joint). La plataforma
       del dron esta en X=3.35. Sin esta placa la moneda cruza ~0.4m en
       caida libre y nunca llega: este puente le da soporte continuo
       hasta la plataforma del dron. -->
  <link name="placa_muelle">
    <visual><geometry><box size="0.7 0.3 0.05"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="acero"/></visual>
    <collision><geometry><box size="0.7 0.3 0.05"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
  </link>
  <joint name="j_placa_muelle" type="fixed">
    <parent link="base_planta"/><child link="placa_muelle"/>
    <origin xyz="3.15 -4.0 0.58" rpy="0 0 0"/>
  </joint>

</robot>
