<?xml version="1.0"?>
<!-- ================================================================
     SISTEMA DE LOGISTICA DE MONEDAS INTELIGENTES - GRUPO 3
     dron.urdf  -  cuerpo independiente de la planta.

     Se carga con p.loadURDF(..., useFixedBase=False): es un cuerpo
     libre de 6 grados de libertad (posicion + orientacion), no un
     link mas de planta_monedas.urdf. Asi puede recibir vasos en su
     posicion de "muelle" y despues volar la pista de obstaculos sin
     reestructurar nada.

     Origen del link base = centro de masa del cuerpo central.
     La "plataforma_carga" es donde debe caer el vaso que entrega
     cinta_3 (altura pensada para igualar z=0.605, la superficie de
     las bandas, cuando el dron esta posado).
     ================================================================ -->
<robot name="dron_g3">

  <material name="dron_cuerpo_c"><color rgba="0.15 0.15 0.17 1"/></material>
  <material name="dron_brazo_c"><color rgba="0.08 0.08 0.09 1"/></material>
  <material name="dron_helice_c"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="dron_led_c"><color rgba="0.85 0.15 0.15 1"/></material>
  <material name="plataforma_c"><color rgba="0.90 0.90 0.92 1"/></material>

  <link name="dron_base">
    <visual><geometry><box size="0.3 0.3 0.1"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="dron_cuerpo_c"/></visual>
    <visual><geometry><cylinder radius="0.02" length="0.02"/></geometry><origin xyz="0.16 0.16 0.06" rpy="0 0 0"/><material name="dron_led_c"/></visual>
    <visual><geometry><cylinder radius="0.02" length="0.02"/></geometry><origin xyz="-0.16 0.16 0.06" rpy="0 0 0"/><material name="dron_led_c"/></visual>
    <visual><geometry><cylinder radius="0.02" length="0.02"/></geometry><origin xyz="0.16 -0.16 0.06" rpy="0 0 0"/><material name="dron_led_c"/></visual>
    <visual><geometry><cylinder radius="0.02" length="0.02"/></geometry><origin xyz="-0.16 -0.16 0.06" rpy="0 0 0"/><material name="dron_led_c"/></visual>
    <collision><geometry><box size="0.3 0.3 0.1"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
    <inertial><mass value="1.2"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>
  <link name="dron_brazo_0">
    <visual><geometry><cylinder radius="0.015" length="0.3"/></geometry><origin xyz="0.0990 0.0990 0.02" rpy="1.5708 0 2.3562"/><material name="dron_brazo_c"/></visual>
    <inertial><mass value="0.05"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="j_dron_brazo_0" type="fixed">
    <parent link="dron_base"/><child link="dron_brazo_0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="dron_helice_0">
    <visual><geometry><cylinder radius="0.1" length="0.01"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="dron_helice_c"/></visual>
    <inertial><mass value="0.02"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
  </link>
  <joint name="j_dron_helice_0" type="continuous">
    <parent link="dron_brazo_0"/><child link="dron_helice_0"/>
    <origin xyz="0.1980 0.1980 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="dron_brazo_1">
    <visual><geometry><cylinder radius="0.015" length="0.3"/></geometry><origin xyz="-0.0990 0.0990 0.02" rpy="1.5708 0 3.9270"/><material name="dron_brazo_c"/></visual>
    <inertial><mass value="0.05"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="j_dron_brazo_1" type="fixed">
    <parent link="dron_base"/><child link="dron_brazo_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="dron_helice_1">
    <visual><geometry><cylinder radius="0.1" length="0.01"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="dron_helice_c"/></visual>
    <inertial><mass value="0.02"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
  </link>
  <joint name="j_dron_helice_1" type="continuous">
    <parent link="dron_brazo_1"/><child link="dron_helice_1"/>
    <origin xyz="-0.1980 0.1980 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="dron_brazo_2">
    <visual><geometry><cylinder radius="0.015" length="0.3"/></geometry><origin xyz="-0.0990 -0.0990 0.02" rpy="1.5708 0 5.4978"/><material name="dron_brazo_c"/></visual>
    <inertial><mass value="0.05"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="j_dron_brazo_2" type="fixed">
    <parent link="dron_base"/><child link="dron_brazo_2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="dron_helice_2">
    <visual><geometry><cylinder radius="0.1" length="0.01"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="dron_helice_c"/></visual>
    <inertial><mass value="0.02"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
  </link>
  <joint name="j_dron_helice_2" type="continuous">
    <parent link="dron_brazo_2"/><child link="dron_helice_2"/>
    <origin xyz="-0.1980 -0.1980 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="dron_brazo_3">
    <visual><geometry><cylinder radius="0.015" length="0.3"/></geometry><origin xyz="0.0990 -0.0990 0.02" rpy="1.5708 0 7.0686"/><material name="dron_brazo_c"/></visual>
    <inertial><mass value="0.05"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="j_dron_brazo_3" type="fixed">
    <parent link="dron_base"/><child link="dron_brazo_3"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="dron_helice_3">
    <visual><geometry><cylinder radius="0.1" length="0.01"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="dron_helice_c"/></visual>
    <inertial><mass value="0.02"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
  </link>
  <joint name="j_dron_helice_3" type="continuous">
    <parent link="dron_brazo_3"/><child link="dron_helice_3"/>
    <origin xyz="0.1980 -0.1980 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="plataforma_carga">
    <visual><geometry><box size="0.24 0.24 0.02"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="plataforma_c"/></visual>
    <collision><geometry><box size="0.24 0.24 0.02"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
    <inertial><mass value="0.15"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="j_plataforma_carga" type="fixed">
    <parent link="dron_base"/><child link="plataforma_carga"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

</robot>
