<?xml version="1.0"?>
<!-- ================================================================
     SISTEMA DE LOGISTICA DE MONEDAS INTELIGENTES - GRUPO 3
     planta_servos_v4.urdf

     Rediseno: banda UNICA RECTA (no mas forma en L) con tres
     estaciones de servomotor + paleta a lo largo de su recorrido,
     cada una con su vaso al lado. Reemplaza brazo1/brazo2 (brazos
     de 3 DOF) que ya no se usan.

     Sistema de referencia: X a lo largo de la banda, Y transversal,
     Z arriba. Superficie util de la banda: z=0.605 (igual que en las
     versiones anteriores, mismo diseno de bastidor+banda).

     Recorrido: maquina (X=-1.9) -> banda recta (X -1 a 7) -> dron
     (X=7.5). Estaciones de servo en X=1.5 ($1000), X=3.5 ($500),
     X=5.5 ($200), todas en el lado +Y de la banda.
     ================================================================ -->
<robot name="planta_servos_g3">

  <material name="azul_metal"><color rgba="0.05 0.15 0.35 1"/></material>
  <material name="caucho_negro"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="blanco_maquina"><color rgba="0.93 0.93 0.96 1"/></material>
  <material name="acero"><color rgba="0.45 0.45 0.48 1"/></material>
  <material name="piso"><color rgba="0.28 0.28 0.30 1"/></material>
  <material name="carro"><color rgba="0.10 0.30 0.60 1"/></material>
  <material name="led_verde"><color rgba="0.10 0.85 0.20 1"/></material>
  <material name="led_ambar"><color rgba="0.95 0.70 0.10 1"/></material>
  <material name="led_rojo"><color rgba="0.90 0.10 0.10 1"/></material>
  <material name="sensor"><color rgba="0.15 0.15 0.18 1"/></material>
  <material name="servo_cuerpo"><color rgba="0.20 0.20 0.22 1"/></material>
  <material name="paleta_c"><color rgba="0.85 0.55 0.10 1"/></material>

  <!-- ================= RAIZ DE LA PLANTA ================= -->
  <link name="base_planta">
    <visual><geometry><box size="12.0 4.0 0.05"/></geometry><origin xyz="3.0 0.0 -0.025" rpy="0 0 0"/><material name="piso"/></visual>
    <inertial><mass value="1000.0"/><inertia ixx="100.0" ixy="0" ixz="0" iyy="100.0" iyz="0" izz="100.0"/></inertial>
  </link>

  <!-- ========== MAQUINA CLASIFICADORA (extremo izquierdo) ========== -->
  <link name="maquina_base">
    <visual><geometry><box size="2.0 1.2 0.1"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="azul_metal"/></visual>
    <collision><geometry><box size="2.0 1.2 0.1"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
    <inertial><mass value="50.0"/><inertia ixx="10.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="10.0"/></inertial>
  </link>
  <joint name="j_maquina_base" type="fixed">
    <parent link="base_planta"/><child link="maquina_base"/>
    <origin xyz="-1.9 0 0.05" rpy="0 0 0"/>
  </joint>
  <link name="maquina_cuerpo">
    <visual><geometry><box size="1.8 1.2 1.5"/></geometry><origin xyz="0 0 0.75" rpy="0 0 0"/><material name="blanco_maquina"/></visual>
    <visual><geometry><cylinder radius="0.05" length="0.04"/></geometry><origin xyz="-0.55 -0.61 1.25" rpy="1.5708 0 0"/><material name="led_verde"/></visual>
    <visual><geometry><cylinder radius="0.05" length="0.04"/></geometry><origin xyz="-0.35 -0.61 1.25" rpy="1.5708 0 0"/><material name="led_ambar"/></visual>
    <visual><geometry><cylinder radius="0.05" length="0.04"/></geometry><origin xyz="-0.15 -0.61 1.25" rpy="1.5708 0 0"/><material name="led_rojo"/></visual>
    <collision><geometry><box size="1.8 1.2 1.5"/></geometry><origin xyz="0 0 0.75" rpy="0 0 0"/></collision>
    <inertial><mass value="80.0"/><inertia ixx="20.0" ixy="0" ixz="0" iyy="20.0" iyz="0" izz="20.0"/></inertial>
  </link>
  <joint name="j_maquina_cuerpo" type="fixed">
    <parent link="maquina_base"/><child link="maquina_cuerpo"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  <link name="maquina_tolva">
    <visual><geometry><cylinder radius="0.38" length="0.3"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><cylinder radius="0.3" length="0.1"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/><material name="azul_metal"/></visual>
    <inertial><mass value="5.0"/><inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.5"/></inertial>
  </link>
  <joint name="j_maquina_tolva" type="fixed">
    <parent link="maquina_cuerpo"/><child link="maquina_tolva"/>
    <origin xyz="0 0 1.65" rpy="0 0 0"/>
  </joint>
  <link name="maquina_salida">
    <visual><geometry><box size="0.6 0.34 0.04"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="acero"/></visual>
    <inertial><mass value="2.0"/><inertia ixx="0.2" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.2"/></inertial>
  </link>
  <joint name="j_maquina_salida" type="fixed">
    <parent link="maquina_cuerpo"/><child link="maquina_salida"/>
    <origin xyz="1.16 0 0.63" rpy="0 0.30 0"/>
  </joint>

  <!-- ========== BANDA PRINCIPAL (recta, 8m, X de -1 a 7) ========== -->
  <link name="banda_principal">
    <visual><geometry><box size="8.0 0.4 0.1"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="azul_metal"/></visual>
    <visual><geometry><box size="7.9 0.3 0.05"/></geometry><origin xyz="0 0 0.08" rpy="0 0 0"/><material name="caucho_negro"/></visual>
    <visual><geometry><cylinder radius="0.06" length="0.32"/></geometry><origin xyz="-3.95 0 0.055" rpy="1.5708 0 0"/><material name="acero"/></visual>
    <visual><geometry><cylinder radius="0.06" length="0.32"/></geometry><origin xyz=" 3.95 0 0.055" rpy="1.5708 0 0"/><material name="acero"/></visual>
    <visual><geometry><cylinder radius="0.04" length="0.45"/></geometry><origin xyz="-3.6 -0.15 -0.275" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><cylinder radius="0.04" length="0.45"/></geometry><origin xyz="-3.6 0.15 -0.275" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><cylinder radius="0.04" length="0.45"/></geometry><origin xyz="-1.8 -0.15 -0.275" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><cylinder radius="0.04" length="0.45"/></geometry><origin xyz="-1.8 0.15 -0.275" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><cylinder radius="0.04" length="0.45"/></geometry><origin xyz="0.0 -0.15 -0.275" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><cylinder radius="0.04" length="0.45"/></geometry><origin xyz="0.0 0.15 -0.275" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><cylinder radius="0.04" length="0.45"/></geometry><origin xyz="1.8 -0.15 -0.275" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><cylinder radius="0.04" length="0.45"/></geometry><origin xyz="1.8 0.15 -0.275" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><cylinder radius="0.04" length="0.45"/></geometry><origin xyz="3.6 -0.15 -0.275" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><cylinder radius="0.04" length="0.45"/></geometry><origin xyz="3.6 0.15 -0.275" rpy="0 0 0"/><material name="acero"/></visual>
    <collision><geometry><box size="8.0 0.4 0.1"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
    <collision><geometry><box size="7.9 0.3 0.05"/></geometry><origin xyz="0 0 0.08" rpy="0 0 0"/></collision>
    <inertial><mass value="40.0"/><inertia ixx="15.0" ixy="0" ixz="0" iyy="15.0" iyz="0" izz="15.0"/></inertial>
  </link>
  <joint name="j_banda_principal" type="fixed">
    <parent link="base_planta"/><child link="banda_principal"/>
    <origin xyz="3.0 0.0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- ========== ESTACION DE RECONOCIMIENTO (antes de los servos) ========== -->
  <link name="estacion_reconocimiento">
    <visual><geometry><box size="0.06 0.06 0.55"/></geometry><origin xyz="0 -0.32 0.275" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><box size="0.06 0.06 0.55"/></geometry><origin xyz="0  0.32 0.275" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><box size="0.1 0.7 0.08"/></geometry><origin xyz="0  0.00 0.585" rpy="0 0 0"/><material name="acero"/></visual>
    <visual><geometry><box size="0.08 0.12 0.1"/></geometry><origin xyz="0  0.00 0.505" rpy="0 0 0"/><material name="sensor"/></visual>
    <inertial><mass value="3.0"/><inertia ixx="0.3" ixy="0" ixz="0" iyy="0.3" iyz="0" izz="0.3"/></inertial>
  </link>
  <joint name="j_estacion_reconocimiento" type="fixed">
    <parent link="base_planta"/><child link="estacion_reconocimiento"/>
    <origin xyz="0.3 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="servo_1000_base">
    <visual><geometry><box size="0.1 0.1 0.15"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="servo_cuerpo"/></visual>
    <collision><geometry><box size="0.1 0.1 0.15"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>
  <joint name="j_servo_1000_planta" type="fixed">
    <parent link="base_planta"/><child link="servo_1000_base"/>
    <origin xyz="1.5 0.22 0.53" rpy="0 0 0"/>
  </joint>
  <link name="servo_1000_paleta">
    <visual><geometry><box size="0.36 0.04 0.12"/></geometry><origin xyz="0.18 0 0" rpy="0 0 0"/><material name="paleta_c"/></visual>
    <collision><geometry><box size="0.36 0.04 0.12"/></geometry><origin xyz="0.18 0 0" rpy="0 0 0"/></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="j_servo_1000_paleta" type="revolute">
    <parent link="servo_1000_base"/><child link="servo_1000_paleta"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.1" upper="1.8" effort="20.0" velocity="6.0"/>
  </joint>
  <link name="servo_500_base">
    <visual><geometry><box size="0.1 0.1 0.15"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="servo_cuerpo"/></visual>
    <collision><geometry><box size="0.1 0.1 0.15"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>
  <joint name="j_servo_500_planta" type="fixed">
    <parent link="base_planta"/><child link="servo_500_base"/>
    <origin xyz="3.5 0.22 0.53" rpy="0 0 0"/>
  </joint>
  <link name="servo_500_paleta">
    <visual><geometry><box size="0.36 0.04 0.12"/></geometry><origin xyz="0.18 0 0" rpy="0 0 0"/><material name="paleta_c"/></visual>
    <collision><geometry><box size="0.36 0.04 0.12"/></geometry><origin xyz="0.18 0 0" rpy="0 0 0"/></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="j_servo_500_paleta" type="revolute">
    <parent link="servo_500_base"/><child link="servo_500_paleta"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.1" upper="1.8" effort="20.0" velocity="6.0"/>
  </joint>
  <link name="servo_200_base">
    <visual><geometry><box size="0.1 0.1 0.15"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="servo_cuerpo"/></visual>
    <collision><geometry><box size="0.1 0.1 0.15"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>
  <joint name="j_servo_200_planta" type="fixed">
    <parent link="base_planta"/><child link="servo_200_base"/>
    <origin xyz="5.5 0.22 0.53" rpy="0 0 0"/>
  </joint>
  <link name="servo_200_paleta">
    <visual><geometry><box size="0.36 0.04 0.12"/></geometry><origin xyz="0.18 0 0" rpy="0 0 0"/><material name="paleta_c"/></visual>
    <collision><geometry><box size="0.36 0.04 0.12"/></geometry><origin xyz="0.18 0 0" rpy="0 0 0"/></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="j_servo_200_paleta" type="revolute">
    <parent link="servo_200_base"/><child link="servo_200_paleta"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.1" upper="1.8" effort="20.0" velocity="6.0"/>
  </joint>

  <!-- ========== VASOS (uno por servo, al lado en +Y) ========== -->
  <link name="vaso_1000">
    <visual><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/><material name="azul_metal"/></visual>
    <visual><geometry><cylinder radius="0.14" length="0.04"/></geometry><origin xyz="0 0 0.40" rpy="0 0 0"/><material name="blanco_maquina"/></visual>
    <collision><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.2" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.2"/></inertial>
  </link>
  <joint name="j_vaso_1000" type="fixed">
    <parent link="base_planta"/><child link="vaso_1000"/>
    <origin xyz="1.5 0.65 0.0" rpy="0 0 0"/>
  </joint>
  <link name="vaso_500">
    <visual><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/><material name="azul_metal"/></visual>
    <visual><geometry><cylinder radius="0.14" length="0.04"/></geometry><origin xyz="0 0 0.40" rpy="0 0 0"/><material name="blanco_maquina"/></visual>
    <collision><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.2" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.2"/></inertial>
  </link>
  <joint name="j_vaso_500" type="fixed">
    <parent link="base_planta"/><child link="vaso_500"/>
    <origin xyz="3.5 0.65 0.0" rpy="0 0 0"/>
  </joint>
  <link name="vaso_200">
    <visual><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/><material name="azul_metal"/></visual>
    <visual><geometry><cylinder radius="0.14" length="0.04"/></geometry><origin xyz="0 0 0.40" rpy="0 0 0"/><material name="blanco_maquina"/></visual>
    <collision><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.2" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.2"/></inertial>
  </link>
  <joint name="j_vaso_200" type="fixed">
    <parent link="base_planta"/><child link="vaso_200"/>
    <origin xyz="5.5 0.65 0.0" rpy="0 0 0"/>
  </joint>

  <!-- El dron se carga aparte en el script (useFixedBase=False), -->
  <!-- igual que en las versiones anteriores; aqui no hace falta link. -->

</robot>
