  <!-- ========== MODULO 5: BRAZO 2 (despacho, junto a cinta_3) ========== -->
  <link name="brazo2_base">
    <visual>
      <geometry><cylinder radius="0.25" length="0.15"/></geometry>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <material name="acero"/>
