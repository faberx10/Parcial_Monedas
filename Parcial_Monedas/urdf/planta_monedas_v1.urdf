    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="-1.8 -0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="-1.8 0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="0.0 -0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="0.0 0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="1.8 -0.15 -0.275" rpy="0 0 0"/>
