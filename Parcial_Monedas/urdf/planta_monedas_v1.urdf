  </link>
  <joint name="j_estacion_sensado" type="fixed">
    <parent link="base_planta"/>
    <child  link="estacion_sensado"/>
    <origin xyz="0.2 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ========== MODULO 4: BRAZO 1 (clasificacion, junto a cinta_1) ========== -->
  <link name="brazo1_base">
    <visual>
      <geometry><cylinder radius="0.25" length="0.15"/></geometry>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <joint name="j_brazo1_planta" type="fixed">
    <parent link="base_planta"/>
    <child  link="brazo1_base"/>
    <origin xyz="1.50 -0.80 0.0" rpy="0 0 1.5708"/>
  </joint>
  <link name="brazo1_seg1">
    <visual>
      <geometry><cylinder radius="0.06" length="0.5"/></geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <material name="brazo_a"/>
    </visual>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
