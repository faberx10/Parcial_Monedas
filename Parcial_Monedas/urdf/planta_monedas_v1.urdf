<?xml version="1.0"?>
<!-- ================================================================
     SISTEMA DE LOGISTICA DE MONEDAS INTELIGENTES - GRUPO 3
     planta_monedas_v1.urdf   |   FASE 1: reparacion geometrica

     Derivado de maqueta.urdf (repo dialejobv/U_Militar).
     Correcciones aplicadas:
       - 7 raices -> 1 raiz (base_planta). Se eliminaron los links
         vacios cinta_seg*_link y se conectaron los links reales.
       - Offsets "horneados" en los <origin> de los <visual>
         trasladados a los <origin> de los <joint>.
       - Se anadieron <collision> a bandas, maquina y contenedores.
       - Vasos sueltos -> contenedores de monedas clasificadas.
     Todos los joints siguen siendo fixed. La articulacion real
     (revolute/prismatic) entra en la FASE 2.

     Sistema de referencia: X derecha, Y hacia el fondo, Z arriba.
     Superficie util de las bandas: z = 0.605 m
     ================================================================ -->
<robot name="planta_monedas_g3">

  <!-- ================= MATERIALES ================= -->
  <material name="azul_metal"><color rgba="0.05 0.15 0.35 1"/></material>
  <material name="caucho_negro"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="blanco_maquina"><color rgba="0.93 0.93 0.96 1"/></material>
  <material name="acero"><color rgba="0.45 0.45 0.48 1"/></material>
  <material name="piso"><color rgba="0.28 0.28 0.30 1"/></material>
  <material name="brazo_a"><color rgba="0.20 0.60 0.80 1"/></material>
  <material name="brazo_b"><color rgba="0.90 0.50 0.10 1"/></material>
  <material name="pinza"><color rgba="0.80 0.20 0.20 1"/></material>
  <material name="dedo"><color rgba="0.90 0.90 0.90 1"/></material>
  <material name="carro"><color rgba="0.10 0.30 0.60 1"/></material>
  <material name="led_verde"><color rgba="0.10 0.85 0.20 1"/></material>
  <material name="led_ambar"><color rgba="0.95 0.70 0.10 1"/></material>
  <material name="led_rojo"><color rgba="0.90 0.10 0.10 1"/></material>
  <material name="sensor"><color rgba="0.15 0.15 0.18 1"/></material>

  <!-- ================= RAIZ DE LA PLANTA ================= -->
  <link name="base_planta">
    <visual>
      <geometry><box size="9.0 7.0 0.05"/></geometry>
      <origin xyz="1.0 -2.0 -0.025" rpy="0 0 0"/>
      <material name="piso"/>
    </visual>
    <inertial>
      <mass value="1000.0"/>
      <inertia ixx="100.0" ixy="0" ixz="0" iyy="100.0" iyz="0" izz="100.0"/>
    </inertial>
  </link>

  <!-- ========== MODULO 1: MAQUINA CLASIFICADORA ========== -->
  <link name="maquina_base">
    <visual>
      <geometry><box size="2.0 1.2 0.1"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="azul_metal"/>
    </visual>
    <collision>
      <geometry><box size="2.0 1.2 0.1"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="10.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="10.0"/>
    </inertial>
  </link>
  <joint name="j_maquina_base" type="fixed">
    <parent link="base_planta"/>
    <child  link="maquina_base"/>
    <origin xyz="-1.9 0 0.05" rpy="0 0 0"/>
  </joint>
  <link name="maquina_cuerpo">
    <visual>
      <geometry><box size="1.8 1.2 1.5"/></geometry>
      <origin xyz="0 0 0.75" rpy="0 0 0"/>
      <material name="blanco_maquina"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <origin xyz="-0.55 -0.61 1.25" rpy="1.5708 0 0"/>
      <material name="led_verde"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <origin xyz="-0.35 -0.61 1.25" rpy="1.5708 0 0"/>
      <material name="led_ambar"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <origin xyz="-0.15 -0.61 1.25" rpy="1.5708 0 0"/>
      <material name="led_rojo"/>
    </visual>
    <collision>
      <geometry><box size="1.8 1.2 1.5"/></geometry>
      <origin xyz="0 0 0.75" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="80.0"/>
      <inertia ixx="20.0" ixy="0" ixz="0" iyy="20.0" iyz="0" izz="20.0"/>
    </inertial>
  </link>
  <joint name="j_maquina_cuerpo" type="fixed">
    <parent link="maquina_base"/>
    <child  link="maquina_cuerpo"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  <link name="maquina_tolva">
    <visual>
      <geometry><cylinder radius="0.38" length="0.3"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.3" length="0.1"/></geometry>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <material name="azul_metal"/>
    </visual>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.5"/>
    </inertial>
  </link>
  <joint name="j_maquina_tolva" type="fixed">
    <parent link="maquina_cuerpo"/>
    <child  link="maquina_tolva"/>
    <origin xyz="0 0 1.65" rpy="0 0 0"/>
  </joint>
  <link name="maquina_salida">
    <visual>
      <geometry><box size="0.6 0.34 0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <collision>
      <geometry><box size="0.6 0.34 0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.2" ixy="0" ixz="0" iyy="0.2" iyz="0" izz="0.2"/>
    </inertial>
  </link>
  <joint name="j_maquina_salida" type="fixed">
    <parent link="maquina_cuerpo"/>
    <child  link="maquina_salida"/>
    <origin xyz="1.16 0 0.63" rpy="0 0.30 0"/>
  </joint>

  <!-- ========== MODULO 2: BANDAS TRANSPORTADORAS (L) ========== -->
  <!-- cinta_1: X de -1.0 a 3.0  en Y=0        (sale de la maquina) -->
  <link name="cinta_1">
    <visual>
      <geometry><box size="4.0 0.4 0.1"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="azul_metal"/>
    </visual>
    <visual>
      <geometry><box size="3.9 0.3 0.05"/></geometry>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <material name="caucho_negro"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.06" length="0.32"/></geometry>
      <origin xyz="-1.95 0 0.055" rpy="1.5708 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.06" length="0.32"/></geometry>
      <origin xyz=" 1.95 0 0.055" rpy="1.5708 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="-1.8 -0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="-1.8 0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="0.0 -0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="0.0 0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="1.8 -0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="1.8 0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <collision>
      <geometry><box size="4.0 0.4 0.1"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <collision>
      <geometry><box size="3.9 0.3 0.05"/></geometry>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="10.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="10.0"/>
    </inertial>
  </link>
  <joint name="j_cinta_1" type="fixed">
    <parent link="base_planta"/>
    <child  link="cinta_1"/>
    <origin xyz="1.0 0.0 0.5" rpy="0 0 0"/>
  </joint>
  <!-- cinta_2: Y de -4.0 a 0.0  en X=-1.0     (bajante, girada 90) -->
  <link name="cinta_2">
    <visual>
      <geometry><box size="4.0 0.4 0.1"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="azul_metal"/>
    </visual>
    <visual>
      <geometry><box size="3.9 0.3 0.05"/></geometry>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <material name="caucho_negro"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.06" length="0.32"/></geometry>
      <origin xyz="-1.95 0 0.055" rpy="1.5708 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.06" length="0.32"/></geometry>
      <origin xyz=" 1.95 0 0.055" rpy="1.5708 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="-1.8 -0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="-1.8 0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="0.0 -0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="0.0 0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="1.8 -0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.04" length="0.45"/></geometry>
      <origin xyz="1.8 0.15 -0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <collision>
      <geometry><box size="4.0 0.4 0.1"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <collision>
      <geometry><box size="3.9 0.3 0.05"/></geometry>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="10.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="10.0"/>
    </inertial>
  </link>
  <joint name="j_cinta_2" type="fixed">
    <parent link="base_planta"/>
    <child  link="cinta_2"/>
    <origin xyz="-1.0 -2.0 0.5" rpy="0 0 1.5708"/>
  </joint>
  <!-- cinta_3: X de -1.0 a 3.0  en Y=-4.0     (salida a despacho) -->
  <link name="cinta_3">
    <visual>
      <geometry><box size="4.0 0.4 0.1"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="azul_metal"/>
    </visual>
    <visual>
      <geometry><box size="3.9 0.3 0.05"/></geometry>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <material name="caucho_negro"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.06" length="0.32"/></geometry>
      <origin xyz="-1.95 0 0.055" rpy="1.5708 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.06" length="0.32"/></geometry>
