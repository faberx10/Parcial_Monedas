    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="10.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="10.0"/>
    </inertial>
  </link>
  <joint name="j_cinta_3" type="fixed">
    <parent link="base_planta"/>
    <child  link="cinta_3"/>
    <origin xyz="1.0 -4.0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- ========== MODULO 3: ESTACION DE SENSADO (ESP32) ========== -->
  <link name="estacion_sensado">
    <visual>
      <geometry><box size="0.06 0.06 0.55"/></geometry>
      <origin xyz="0 -0.32 0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><box size="0.06 0.06 0.55"/></geometry>
      <origin xyz="0  0.32 0.275" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><box size="0.1 0.7 0.08"/></geometry>
      <origin xyz="0  0.00 0.585" rpy="0 0 0"/>
      <material name="acero"/>
    </visual>
    <visual>
      <geometry><box size="0.08 0.12 0.1"/></geometry>
      <origin xyz="0  0.00 0.505" rpy="0 0 0"/>
