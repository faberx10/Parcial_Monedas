  </link>
  <joint name="j_brazo1_hombro" type="fixed">
    <parent link="brazo1_base"/>
    <child  link="brazo1_seg1"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>
  <link name="brazo1_seg2">
    <visual>
      <geometry><cylinder radius="0.05" length="0.45"/></geometry>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <material name="brazo_b"/>
    </visual>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>
  </link>
  <joint name="j_brazo1_codo" type="fixed">
    <parent link="brazo1_seg1"/>
    <child  link="brazo1_seg2"/>
    <origin xyz="0 0 0.50" rpy="0 1.5708 0"/>
  </joint>
  <link name="brazo1_gripper">
