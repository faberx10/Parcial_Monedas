  <link name="contenedor_200">
    <visual><geometry><cylinder radius="0.13" length="0.4"/></geometry><origin xyz="0 0 0.20" rpy="0 0 0"/><material name="azul_metal"/></visual>
    <visual><geometry><cylinder radius="0.14" length="0.04"/></geometry><origin xyz="0 0 0.40" rpy="0 0 0"/><material name="blanco_maquina"/></visual>
