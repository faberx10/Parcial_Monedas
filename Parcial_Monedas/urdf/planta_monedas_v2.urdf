    <origin xyz="0.2 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ========== BRAZO 1 (clasificacion, junto a cinta_1) ========== -->
  <link name="brazo1_base">
    <visual><geometry><cylinder radius="0.25" length="0.15"/></geometry><origin xyz="0 0 0.075" rpy="0 0 0"/><material name="acero"/></visual>
    <inertial><mass value="5.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
  </link>
  <joint name="j_brazo1_planta" type="fixed">
    <parent link="base_planta"/><child link="brazo1_base"/>
    <origin xyz="1.50 -0.80 0.0" rpy="0 0 1.5708"/>
  </joint>
  <link name="brazo1_seg1">
    <visual><geometry><cylinder radius="0.06" length="0.5"/></geometry><origin xyz="0 0 0.25" rpy="0 0 0"/><material name="brazo_a"/></visual>
    <inertial><mass value="2.0"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/></inertial>
  </link>
  <joint name="j_brazo1_hombro" type="revolute">
    <parent link="brazo1_base"/><child link="brazo1_seg1"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="15.0" velocity="2.0"/>
  </joint>
  <link name="brazo1_seg2">
    <visual><geometry><cylinder radius="0.05" length="0.45"/></geometry><origin xyz="0 0 0.225" rpy="0 0 0"/><material name="brazo_b"/></visual>
    <inertial><mass value="1.5"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/></inertial>
  </link>
  <joint name="j_brazo1_codo" type="revolute">
    <parent link="brazo1_seg1"/><child link="brazo1_seg2"/>
    <origin xyz="0 0 0.50" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10.0" velocity="2.0"/>
  </joint>
  <link name="brazo1_gripper">
    <visual><geometry><box size="0.1 0.14 0.04"/></geometry><origin xyz="0 0 0.02" rpy="0 0 0"/><material name="pinza"/></visual>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
